generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }

enum BedStatus { AVAILABLE RESERVED OCCUPIED CLEANING OUT_OF_SERVICE }
enum AppointmentStatus { SCHEDULED CHECKED_IN IN_CONSULTATION COMPLETED CANCELLED NO_SHOW }
enum EncounterStatus { OPEN CLOSED }
enum AdmissionStatus { ACTIVE TRANSFERRED DISCHARGED }
enum UserStatus { ACTIVE INACTIVE LOCKED }

model Hospital { id String @id @default(cuid()) name String code String @unique campuses Campus[] departments Department[] patients Patient[] users User[] rooms Room[] emergencyCases EmergencyCase[] icuStays ICUStay[] otCases OTCase[] bloodUnits BloodUnit[] ambulanceTrips AmbulanceTrip[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Campus { id String @id @default(cuid()) name String hospitalId String hospital Hospital @relation(fields:[hospitalId],references:[id]) buildings Building[] rooms Room[] }
model Building { id String @id @default(cuid()) name String campusId String campus Campus @relation(fields:[campusId],references:[id]) floors Floor[] rooms Room[] }
model Floor { id String @id @default(cuid()) name String buildingId String building Building @relation(fields:[buildingId],references:[id]) wards Ward[] rooms Room[] }
model Ward { id String @id @default(cuid()) name String floorId String floor Floor @relation(fields:[floorId],references:[id]) beds Bed[] rooms Room[] }
model Room { id String @id @default(cuid()) number String name String? hospitalId String campusId String buildingId String floorId String wardId String hospital Hospital @relation(fields:[hospitalId],references:[id]) campus Campus @relation(fields:[campusId],references:[id]) building Building @relation(fields:[buildingId],references:[id]) floor Floor @relation(fields:[floorId],references:[id]) ward Ward @relation(fields:[wardId],references:[id]) beds Bed[] @@unique([wardId,number]) }
model Bed { id String @id @default(cuid()) number String status BedStatus @default(AVAILABLE) wardId String roomId String? ward Ward @relation(fields:[wardId],references:[id]) room Room? @relation(fields:[roomId],references:[id]) admissions Admission[] @@unique([wardId,number]) @@index([roomId,status]) }
model Department { id String @id @default(cuid()) name String code String hospitalId String hospital Hospital @relation(fields:[hospitalId],references:[id]) doctors Doctor[] appointments Appointment[] @@unique([hospitalId,code]) }
model User { id String @id @default(cuid()) email String @unique passwordHash String status UserStatus @default(ACTIVE) hospitalId String? hospital Hospital? @relation(fields:[hospitalId],references:[id]) roles UserRole[] auditLogs AuditLog[] }
model Role { id String @id @default(cuid()) name String @unique permissions RolePermission[] users UserRole[] }
model Permission { id String @id @default(cuid()) key String @unique roles RolePermission[] }
model UserRole { userId String roleId String user User @relation(fields:[userId],references:[id],onDelete:Cascade) role Role @relation(fields:[roleId],references:[id],onDelete:Cascade) @@id([userId,roleId]) }
model RolePermission { roleId String permissionId String role Role @relation(fields:[roleId],references:[id],onDelete:Cascade) permission Permission @relation(fields:[permissionId],references:[id],onDelete:Cascade) @@id([roleId,permissionId]) }
model Patient { id String @id @default(cuid()) mrn String @unique firstName String lastName String dateOfBirth DateTime? phone String? email String? hospitalId String hospital Hospital @relation(fields:[hospitalId],references:[id]) allergies Allergy[] appointments Appointment[] encounters Encounter[] admissions Admission[] vitals Vital[] prescriptions Prescription[] invoices Invoice[] diagnosticResults DiagnosticResult[] emergencyCases EmergencyCase[] icuStays ICUStay[] otCases OTCase[] ambulanceTrips AmbulanceTrip[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model Allergy { id String @id @default(cuid()) patientId String substance String reaction String? patient Patient @relation(fields:[patientId],references:[id],onDelete:Cascade) }
model Doctor { id String @id @default(cuid()) userId String @unique departmentId String user User @relation(fields:[userId],references:[id]) department Department @relation(fields:[departmentId],references:[id]) appointments Appointment[] encounters Encounter[] prescriptions Prescription[] emergencyCases EmergencyCase[] icuStays ICUStay[] otCases OTCase[] }
model Appointment { id String @id @default(cuid()) patientId String doctorId String departmentId String status AppointmentStatus @default(SCHEDULED) scheduledAt DateTime patient Patient @relation(fields:[patientId],references:[id]) doctor Doctor @relation(fields:[doctorId],references:[id]) department Department @relation(fields:[departmentId],references:[id]) encounter Encounter? createdAt DateTime @default(now()) @@index([departmentId,scheduledAt]) @@index([doctorId,scheduledAt]) }
model Encounter { id String @id @default(cuid()) patientId String doctorId String status EncounterStatus @default(OPEN) startedAt DateTime @default(now()) closedAt DateTime? patient Patient @relation(fields:[patientId],references:[id]) doctor Doctor @relation(fields:[doctorId],references:[id]) appointmentId String? @unique appointment Appointment? @relation(fields:[appointmentId],references:[id]) notes ClinicalNote[] diagnoses Diagnosis[] orders ClinicalOrder[] }
model ClinicalNote { id String @id @default(cuid()) encounterId String authorId String body String createdAt DateTime @default(now()) encounter Encounter @relation(fields:[encounterId],references:[id],onDelete:Cascade) }
model Diagnosis { id String @id @default(cuid()) encounterId String code String description String encounter Encounter @relation(fields:[encounterId],references:[id],onDelete:Cascade) }
model ClinicalOrder { id String @id @default(cuid()) encounterId String type String status String @default("ORDERED") details Json? createdAt DateTime @default(now()) encounter Encounter @relation(fields:[encounterId],references:[id],onDelete:Cascade) diagnosticResults DiagnosticResult[] }
model Admission { id String @id @default(cuid()) patientId String bedId String status AdmissionStatus @default(ACTIVE) admittedAt DateTime @default(now()) dischargedAt DateTime? patient Patient @relation(fields:[patientId],references:[id]) bed Bed @relation(fields:[bedId],references:[id]) transfers AdmissionTransfer[] @@index([bedId,status]) }
model AdmissionTransfer { id String @id @default(cuid()) admissionId String fromBedId String? toBedId String transferredAt DateTime @default(now()) admission Admission @relation(fields:[admissionId],references:[id],onDelete:Cascade) }
model Vital { id String @id @default(cuid()) patientId String recordedBy String recordedAt DateTime @default(now()) temperature Decimal? heartRate Int? respiratoryRate Int? systolic Int? diastolic Int? spo2 Decimal? patient Patient @relation(fields:[patientId],references:[id],onDelete:Cascade) @@index([patientId,recordedAt]) }
model Prescription { id String @id @default(cuid()) patientId String doctorId String status String @default("ACTIVE") createdAt DateTime @default(now()) patient Patient @relation(fields:[patientId],references:[id]) doctor Doctor @relation(fields:[doctorId],references:[id]) items PrescriptionItem[] }
model PrescriptionItem { id String @id @default(cuid()) prescriptionId String medication String dose String? route String? frequency String? duration String? quantity Int? status String @default("ACTIVE") prescription Prescription @relation(fields:[prescriptionId],references:[id],onDelete:Cascade) administrations MedicationAdministration[] }
model MedicationAdministration { id String @id @default(cuid()) prescriptionItemId String patientId String administeredBy String status String @default("GIVEN") administeredAt DateTime @default(now()) notes String? prescriptionItem PrescriptionItem @relation(fields:[prescriptionItemId],references:[id],onDelete:Cascade) patient Patient @relation(fields:[patientId],references:[id]) @@index([patientId,administeredAt]) }
model DiagnosticResult { id String @id @default(cuid()) patientId String orderId String kind String status String @default("PRELIMINARY") result Json? reportedBy String? reportedAt DateTime? createdAt DateTime @default(now()) patient Patient @relation(fields:[patientId],references:[id],onDelete:Cascade) order ClinicalOrder @relation(fields:[orderId],references:[id],onDelete:Cascade) @@index([patientId,createdAt]) @@index([orderId]) }
model Invoice { id String @id @default(cuid()) patientId String status String @default("OPEN") total Decimal @default(0) createdAt DateTime @default(now()) patient Patient @relation(fields:[patientId],references:[id]) items InvoiceItem[] payments Payment[] }
model InvoiceItem { id String @id @default(cuid()) invoiceId String description String quantity Int @default(1) unitPrice Decimal total Decimal invoice Invoice @relation(fields:[invoiceId],references:[id],onDelete:Cascade) }
model Payment { id String @id @default(cuid()) invoiceId String amount Decimal method String status String @default("COMPLETED") reference String? paidAt DateTime @default(now()) invoice Invoice @relation(fields:[invoiceId],references:[id],onDelete:Cascade) }
model InventoryItem { id String @id @default(cuid()) sku String @unique name String category String? unit String @default("unit") quantity Int @default(0) reorderLevel Int @default(0) active Boolean @default(true) movements StockMovement[] createdAt DateTime @default(now()) updatedAt DateTime @updatedAt }
model StockMovement { id String @id @default(cuid()) itemId String type String quantity Int reason String? reference String? createdAt DateTime @default(now()) item InventoryItem @relation(fields:[itemId],references:[id],onDelete:Cascade) @@index([itemId,createdAt]) }
model AuditLog { id String @id @default(cuid()) userId String? action String entity String entityId String? metadata Json? createdAt DateTime @default(now()) user User? @relation(fields:[userId],references:[id]) @@index([entity,entityId]) @@index([createdAt]) }
model EmergencyCase { id String @id @default(cuid()) patientId String hospitalId String doctorId String? triageLevel String @default("3") chiefComplaint String status String @default("ARRIVED") arrivalAt DateTime @default(now()) disposition String? patient Patient @relation(fields:[patientId],references:[id]) hospital Hospital @relation(fields:[hospitalId],references:[id]) doctor Doctor? @relation(fields:[doctorId],references:[id]) @@index([hospitalId,status,arrivalAt]) @@index([patientId,arrivalAt]) }
model ICUStay { id String @id @default(cuid()) patientId String hospitalId String doctorId String? bedLabel String status String @default("ACTIVE") acuity String @default("CRITICAL") startedAt DateTime @default(now()) endedAt DateTime? patient Patient @relation(fields:[patientId],references:[id]) hospital Hospital @relation(fields:[hospitalId],references:[id]) doctor Doctor? @relation(fields:[doctorId],references:[id]) @@index([hospitalId,status]) @@index([patientId,startedAt]) }
model OTCase { id String @id @default(cuid()) patientId String hospitalId String doctorId String? procedure String scheduledAt DateTime status String @default("SCHEDULED") theatre String? patient Patient @relation(fields:[patientId],references:[id]) hospital Hospital @relation(fields:[hospitalId],references:[id]) doctor Doctor? @relation(fields:[doctorId],references:[id]) @@index([hospitalId,status,scheduledAt]) }
model BloodUnit { id String @id @default(cuid()) hospitalId String bloodGroup String component String donationCode String @unique status String @default("AVAILABLE") expiresAt DateTime? hospital Hospital @relation(fields:[hospitalId],references:[id]) @@index([hospitalId,bloodGroup,status]) }
model AmbulanceTrip { id String @id @default(cuid()) hospitalId String patientId String? vehicleCode String driverName String status String @default("AVAILABLE") pickupLocation String? destination String? dispatchedAt DateTime? arrivedAt DateTime? completedAt DateTime? hospital Hospital @relation(fields:[hospitalId],references:[id]) patient Patient? @relation(fields:[patientId],references:[id]) @@index([hospitalId,status]) }
